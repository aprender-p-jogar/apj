# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - APRENDER PARA JOGAR
# ==============================================================================
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase.

# URL pública da sua instância Supabase (encontrada no painel Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co

# Chave anônima pública da Supabase (usada no navegador para consultas com regras RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui

# Chave de Serviço / Service Role (SECRETA - NUNCA exponha no navegador, apenas em Server Actions e rotas do servidor)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role-aqui

# URL base da aplicação (usada para redirecionamentos de autenticação OAuth e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave de API do Google Gemini para geração automática de questões pedagógicas com IA
# Obtenha sua chave gratuitamente em: https://aistudio.google.com
# Se deixado em branco, a plataforma funcionará com o banco demonstrativo de questões.
GEMINI_API_KEY=

